# Enable IMAP/SMTP and create a NAVER application password first.
NAVER_EMAIL=your-id@naver.com
NAVER_APP_PASSWORD=replace-with-application-password
# Optional display name (quote values containing #).
NAVER_SENDER_NAME=""
# Set false to remove send_email from the available MCP tools.
NAVER_ENABLE_SEND=true
